# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend API
API_V1_STR=/api/v1
PROJECT_NAME="FraudLens Gateway"
PORT=8000
HOST=0.0.0.0

# Database Connection
DATABASE_URL=sqlite:///./fraudlens.db
# For PostgreSQL:
# DATABASE_URL=postgresql://fraudlens:fraudlens_secret@db:5432/fraudlens_db

# Model Configuration
MODEL_PATH=ml/models/xgboost_fraud_model.joblib
FRAUD_THRESHOLD_HIGH=0.80
FRAUD_THRESHOLD_REVIEW=0.50

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
