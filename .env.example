# Application Environment (dev, test, prod)
APP_ENV=dev
PROJECT_NAME="FraudLens Gateway"
API_V1_STR=/api/v1

# PostgreSQL Configuration (used by Compose to initialize DB and construct DATABASE_URL)
# Note: Default placeholder credentials are for local development only (host ports bound to 127.0.0.1).
# Production passwords must be strong and URL-safe (avoid reserved URI characters or URL-encode them).
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=fraudlens_db

# Authentication Secrets (required; minimum 32 chars for JWT key)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_32chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_SECONDS=3600
ANALYST_USERNAME=analyst_1
ANALYST_PASSWORD=change_this_analyst_password

# Model & Metrics Configuration
# In dev/test: leave MODEL_PATH empty to use deterministic stub model.
# In production: provide container path to bundle directory (e.g. /app/ml/models/class_weight).
MODEL_PATH=
# Optional research benchmark metrics report path (mounted read-only from ./ml/reports)
# Defaults to ml/reports/metrics.json if omitted. If the file is missing, ml_metrics_status is "unavailable".
METRICS_PATH=ml/reports/metrics.json
FRAUD_THRESHOLD_HIGH=0.70
FRAUD_THRESHOLD_REVIEW=0.40

# Service Port Bindings (bound to 127.0.0.1 on the host)
BACKEND_PORT=8000
FRONTEND_PORT=5173
